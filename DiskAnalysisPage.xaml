<Page x:Class="CleanTag.DiskAnalysisPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CleanTag.Controls" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
 <Page.Resources>
  <DataTemplate x:Key="RowTemplate"><Grid ColumnSpacing="8" Padding="2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding Percent}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate>
 </Page.Resources>
 <Grid x:Name="LayoutRoot" Background="{ThemeResource CanvasBrush}" Padding="20,12" RowSpacing="8" SizeChanged="Layout_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="UpperRow" Height="245"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Disk Analizi" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><CommandBar x:Name="Commands" Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton Icon="Folder" Label="Klasör seç" Click="ChooseFolder_Click"/><AppBarButton Icon="Refresh" Label="Yenile" Click="Scan_Click"/><AppBarButton Icon="FullScreen" Label="Haritayı genişlet" Click="Expand_Click"/><CommandBar.SecondaryCommands><AppBarButton Label="Atlanan konumları göster" Click="Issues_Click"/></CommandBar.SecondaryCommands></CommandBar></Grid>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DriveSelector" Width="100" SelectionChanged="Drive_Changed" AutomationProperties.Name="Sürücü seç"/><TextBox x:Name="PathBox" Grid.Column="1" PlaceholderText="Analiz edilecek klasör yolu" AutomationProperties.Name="Analiz yolu"/><Button x:Name="ScanButton" Grid.Column="2" Content="Analiz et" Click="Scan_Click"/><Button x:Name="CancelButton" Grid.Column="3" Content="Durdur" Click="Cancel_Click" Visibility="Collapsed"/></Grid>
  <InfoBar x:Name="MessageBar" Grid.Row="2" IsOpen="False" IsClosable="True"/>
  <StackPanel Grid.Row="3" Spacing="3"><TextBlock x:Name="SummaryLabel" Text="Herhangi bir klasörü analiz edin. Dosyalar otomatik olarak kütüphaneye kaydedilmez." TextWrapping="Wrap"/><TextBlock x:Name="DriveLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Visibility="Collapsed" Height="3"/></StackPanel>
  <Grid Grid.Row="4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="UpButton" Content="↑ Üst klasör" Click="Up_Click" IsEnabled="False"/><Button Grid.Column="1" Content="Tarama kökü" Click="Root_Click"/><BreadcrumbBar x:Name="Breadcrumb" Grid.Column="2" ItemClicked="Breadcrumb_Click"/></Grid>
  <Grid Grid.Row="5" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" PlaceholderText="Dosya adında ara" TextChanged="Search_Changed" AutomationProperties.Name="Analiz sonuçlarında ara"/><Button Grid.Column="1" Content="Filtreler ve sıralama"><Button.Flyout><Flyout><StackPanel Width="250" Spacing="10"><ComboBox x:Name="SortSelector" Header="Sıralama" SelectedIndex="0" SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch"><x:String>Boyut / yüzde</x:String><x:String>Ad</x:String><x:String>Dosya sayısı</x:String></ComboBox><ComboBox x:Name="ExtensionSelector" Header="Uzantı" SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch"/><ComboBox x:Name="CategorySelector" Header="Kategori" SelectedIndex="0" SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch"><x:String>Tüm kategoriler</x:String><x:String>Görseller</x:String><x:String>Videolar</x:String><x:String>Arşivler</x:String><x:String>Belgeler</x:String><x:String>Sesler</x:String><x:String>Tasarım / model</x:String><x:String>Diğer</x:String></ComboBox><NumberBox x:Name="MinimumSize" Header="En az (MB)" Value="0" Minimum="0" ValueChanged="Minimum_Changed"/><TextBlock Text="Yüzdeler seçili klasörün filtresiz mantıksal toplamına göredir. Ayrılmış fiziksel alan ölçülmez." TextWrapping="Wrap" FontSize="11"/><Button Content="Filtreleri temizle" Click="ClearFilters_Click"/></StackPanel></Flyout></Button.Flyout></Button></Grid>
  <Grid Grid.Row="6" x:Name="Tables" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ExtensionColumn" Width="240"/></Grid.ColumnDefinitions>
   <Grid x:Name="TreePanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Klasör ağacı" ToolTipService.ToolTip="Her dalda en büyük 250 klasör gösterilir. Diğer klasörlere öğe listesinden erişebilirsiniz." FontWeight="SemiBold" FontSize="12"/><TreeView x:Name="FoldersTree" Grid.Row="1" Expanding="Tree_Expanding" ItemInvoked="Tree_Invoked" CanDragItems="False" CanReorderItems="False"/></Grid>
   <Grid Grid.Column="1" RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Öğe · alt öğe sayıları" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Mantıksal" FontSize="12" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="Klasör %" FontSize="12" HorizontalAlignment="Right"/></Grid><ListView x:Name="EntriesList" Grid.Row="1" ItemTemplate="{StaticResource RowTemplate}" SelectionChanged="Entry_Selected" DoubleTapped="Entry_DoubleTapped"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ListLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Content="‹" Click="Previous_Click" AutomationProperties.Name="Önceki analiz sayfası"/><Button Content="›" Click="Next_Click" AutomationProperties.Name="Sonraki analiz sayfası"/></StackPanel></Grid></Grid>
   <Grid x:Name="ExtensionsPanel" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Uzantılar · tarama kökü" FontWeight="SemiBold" FontSize="12"/><ListView x:Name="ExtensionsList" Grid.Row="1" SelectionChanged="Extension_Selected"/></Grid>
  </Grid>
  <Thumb Grid.Row="7" Background="{ThemeResource DividerStrokeColorDefaultBrush}" DragDelta="Splitter_DragDelta" AutomationProperties.Name="Liste ve harita bölmesini boyutlandır"/>
  <controls:StorageTreemap x:Name="Map" Grid.Row="8"/>
  <TextBlock x:Name="HoverLabel" Grid.Row="9" MinHeight="32" FontSize="11" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  <Grid Grid.Row="10" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock x:Name="SelectedLabel" Text="Haritadan veya listeden bir öğe seçin." TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock x:Name="TagsLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LayoutLabel" Text="Renkler: video mavi · görsel yeşil · arşiv turuncu · belge mor · ses pembe" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><CommandBar x:Name="SelectionCommands" Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton x:Name="PreviewButton" Icon="View" Label="Önizle" Click="Preview_Click" IsEnabled="False"/><AppBarButton x:Name="TagButton" Icon="Add" Label="Etiketle" Click="Tag_Click" IsEnabled="False"/><CommandBar.SecondaryCommands><AppBarButton x:Name="RemoveTagButton" Label="Etiket kaldır" Click="RemoveTag_Click" IsEnabled="False"/><AppBarButton x:Name="OpenButton" Label="Aç" Click="Open_Click" IsEnabled="False"/><AppBarButton x:Name="RevealButton" Label="Konumunu göster" Click="Reveal_Click" IsEnabled="False"/><AppBarButton x:Name="PropertiesButton" Label="Özellikler" Click="Properties_Click" IsEnabled="False"/><AppBarButton x:Name="DeleteButton" Label="Çöp Kutusu’na gönder" Click="Delete_Click" IsEnabled="False"/></CommandBar.SecondaryCommands></CommandBar></Grid>
 </Grid>
</Page>
