<UserControl x:Class="CleanTag.Controls.FilePreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Unloaded="Control_Unloaded">
 <Grid RowSpacing="8">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" MinHeight="160">
   <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12" Visibility="Collapsed"/>
   <ScrollViewer x:Name="TextPreviewHost" Visibility="Collapsed" Padding="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <TextBlock x:Name="TextPreview" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono,Consolas" FontSize="13"/>
   </ScrollViewer>
   <MediaPlayerElement x:Name="MediaPreview" AreTransportControlsEnabled="True" AutoPlay="False" Visibility="Collapsed"/>
   <StackPanel x:Name="PreviewFallback" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="340" Margin="20">
    <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource AccentBrush}"/>
    <TextBlock x:Name="FallbackTitle" Text="Önizleme" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
    <TextBlock x:Name="FallbackText" Text="Bir öğe seçin." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
   <ProgressRing x:Name="PreviewLoading" IsActive="False" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="PreviewStatus" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <StackPanel x:Name="PdfControls" Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
    <Button Content="‹" Click="PreviousPage_Click" Padding="10,2" AutomationProperties.Name="Önceki PDF sayfası"/>
    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" FontSize="11"/>
    <Button Content="›" Click="NextPage_Click" Padding="10,2" AutomationProperties.Name="Sonraki PDF sayfası"/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
